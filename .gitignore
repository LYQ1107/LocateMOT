# dataset symlinks and local artifacts are never committed
data/
runs/
third_party/
outputs/stage_l0/*
!outputs/stage_l0/state.json
!outputs/stage_l0/final_status.json
!outputs/stage_l0/checkpoint_manifest.json
!outputs/stage_l0/object_token_cache_manifest.json
